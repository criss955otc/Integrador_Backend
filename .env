# ==========================
# Supabase / PostgreSQL
# ==========================
# Usa Supabase > Connect > Session pooler (puerto 5432)
DB_URL
DB_USERNAME
DB_PASSWORD
DB_POOL_SIZE=10

# ==========================
# JWT
# ==========================
# Genera un secreto aleatorio de 32+ bytes. No lo subas a Git.
JWT_SECRET=7f9c2a8e4d6b1f3a9c7e5d2b8a6f4c1e9d3b7a5f8c2e6d4a1b9f7e3c5a2d8
JWT_EXPIRATION_MS=28800000

# ==========================
# CORS
# ==========================
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ==========================
# Admin inicial (opcional)
# ==========================
ADMIN_CEDULA=0000000000
ADMIN_NOMBRES=Administrador
ADMIN_APELLIDOS=Sistema
ADMIN_PASSWORD=Criss123
